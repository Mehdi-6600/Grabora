# Telegram
BOT_TOKEN=your_bot_token_here
# Use local Bot API server URL for 2GB uploads, e.g. http://localhost:8081
BOT_API_URL=https://api.telegram.org
ADMIN_IDS=123456789,987654321

# Database
DATABASE_PATH=./grabora.db

# Files
TEMP_DIR=./tmp/downloads
MAX_FILE_SIZE_MB=1900

# Base64-encoded YouTube cookies.txt (needed for Render/cloud IPs)
# Generate with: base64 -w0 cookies.txt
YOUTUBE_COOKIES_B64=

# Card-to-card (manual) payment
CARD_NUMBER=6037-XXXX-XXXX-XXXX
CARD_HOLDER=نام صاحب کارت

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/grabora.log


# Scheduler
CLEANUP_INTERVAL_HOURS=1
TEMP_FILE_MAX_AGE_HOURS=1
